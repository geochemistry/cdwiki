---
import Layout from '../layouts/Layout.astro';
import recordings from '../data/recordings.json';

const landmarks = recordings.filter(r => r.isLandmark);
const totalRecordings = recordings.length;
const yearSpan = `${Math.min(...recordings.map(r => r.year))} – ${Math.max(...recordings.map(r => r.year))}`;
const performers = [...new Set(recordings.map(r => r.performer))].length;

const allPerformers = [...new Set(recordings.map(r => r.performer))].sort();
const allLabels = [...new Set(recordings.map(r => r.label))].sort();

// Decade stats for chart
const decadeMap: Record<string, number> = {};
recordings.forEach(r => {
  const decade = `${Math.floor(r.year / 10) * 10}s`;
  decadeMap[decade] = (decadeMap[decade] || 0) + 1;
});
const decades = Object.entries(decadeMap).sort(([a], [b]) => a.localeCompare(b));
const maxCount = Math.max(...decades.map(([, v]) => v));
const instruments = [...new Set(recordings.map(r => r.instrument))];
const instrumentColors: Record<string, string> = {
  Piano: 'bg-gold-500',
  Harpsichord: 'bg-amber-700',
  Violin: 'bg-emerald-600',
};
---

<Layout title="首页">
  <div class="max-w-7xl mx-auto px-4 py-12">
    <!-- Hero + Search -->
    <section class="text-center mb-16">
      <h1 class="text-4xl sm:text-5xl font-serif font-bold text-gold-800 mb-4">
        我收藏的唱片
      </h1>
      <p class="text-gray-500 max-w-2xl mx-auto mb-8">
        收录经典古典音乐录音，涵盖钢琴、羽管键琴、小提琴等多种乐器，
        从 1930 年代至今的经典演绎。
      </p>

      <!-- Search box -->
      <div class="max-w-xl mx-auto relative">
        <input
          type="text"
          id="home-search"
          placeholder="搜索演奏家、厂牌、年份..."
          class="w-full px-5 py-3 pr-12 border border-gray-300 rounded-full text-lg focus:outline-none focus:ring-2 focus:ring-gold-400 shadow-sm"
        />
        <svg class="absolute right-4 top-1/2 -translate-y-1/2 w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
        <!-- Search results dropdown -->
        <div id="search-results" class="hidden absolute z-10 w-full mt-2 bg-white rounded-lg shadow-lg border border-gray-200 max-h-80 overflow-y-auto text-left"></div>
      </div>
    </section>

    <!-- Stats -->
    <section class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-16">
      <div class="card p-6 text-center">
        <div class="text-3xl font-bold text-gold-700">{totalRecordings}</div>
        <div class="text-gray-500 text-sm mt-1">收录录音</div>
      </div>
      <div class="card p-6 text-center">
        <div class="text-3xl font-bold text-gold-700">{performers}</div>
        <div class="text-gray-500 text-sm mt-1">演奏家</div>
      </div>
      <div class="card p-6 text-center">
        <div class="text-3xl font-bold text-gold-700">{yearSpan}</div>
        <div class="text-gray-500 text-sm mt-1">时间跨度</div>
      </div>
      <div class="card p-6 text-center">
        <div class="text-3xl font-bold text-gold-700">{instruments.length}</div>
        <div class="text-gray-500 text-sm mt-1">乐器类型</div>
      </div>
    </section>

    <!-- Chart: recordings by decade -->
    <section class="mb-16">
      <h2 class="text-2xl font-serif font-bold text-gold-800 mb-6">录音数量变化</h2>
      <div class="card p-6">
        <div class="flex items-end gap-2 sm:gap-3 h-48 mb-4">
          {decades.map(([decade, count]) => {
            const pct = Math.round((count / maxCount) * 100);
            // Count per instrument in this decade
            const decadeYear = parseInt(decade);
            const decadeRecordings = recordings.filter(r => r.year >= decadeYear && r.year < decadeYear + 10);
            const instCounts = instruments.map(inst => ({
              inst,
              count: decadeRecordings.filter(r => r.instrument === inst).length,
              total: decadeRecordings.length,
            }));
            return (
              <div class="flex-1 flex flex-col items-center justify-end h-full group relative">
                {/* Stacked bars by instrument */}
                <div class="w-full flex flex-col-reverse justify-start" style={`height: ${pct}%`}>
                  {instCounts.filter(ic => ic.count > 0).map(ic => {
                    const h = Math.round((ic.count / ic.total) * 100);
                    return (
                      <div
                        class={`w-full ${instrumentColors[ic.inst] || 'bg-gray-400'} transition-all group-hover:opacity-80`}
                        style={`height: ${h}%`}
                        title={`${ic.inst}: ${ic.count}`}
                      />
                    );
                  })}
                </div>
                {/* Tooltip */}
                <div class="hidden group-hover:block absolute bottom-full mb-2 bg-gray-900 text-white text-xs rounded px-2 py-1 whitespace-nowrap z-10">
                  {decade}: {count} 张
                </div>
              </div>
            );
          })}
        </div>
        {/* X axis labels */}
        <div class="flex gap-2 sm:gap-3">
          {decades.map(([decade]) => (
            <div class="flex-1 text-center text-xs text-gray-500">{decade}</div>
          ))}
        </div>
        {/* Legend */}
        <div class="flex justify-center gap-4 mt-4 text-sm text-gray-600">
          {instruments.map(inst => (
            <div class="flex items-center gap-1">
              <div class={`w-3 h-3 rounded-sm ${instrumentColors[inst] || 'bg-gray-400'}`} />
              <span>{inst}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Landmark recordings -->
    <section class="mb-16">
      <h2 class="text-2xl font-serif font-bold text-gold-800 mb-6">经典录音</h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {landmarks.map(rec => (
          <a href={`/recordings/${rec.id}`} class="card group">
            <div class="aspect-square bg-gold-100 flex items-center justify-center overflow-hidden">
              <img
                src={rec.coverUrl}
                alt={`${rec.performer} - ${rec.year}`}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform"
                loading="lazy"
                onerror="this.style.display='none'; this.parentElement.innerHTML='<div class=\'text-6xl\'>♪</div>'"
              />
            </div>
            <div class="p-4">
              <h3 class="font-bold text-gray-900">{rec.performer}</h3>
              <p class="text-gold-600 text-sm">{rec.year} &middot; {rec.label}</p>
              <p class="text-gray-500 text-sm mt-1 line-clamp-2">{rec.instrument}</p>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Browse by category -->
    <section class="mb-16">
      <h2 class="text-2xl font-serif font-bold text-gold-800 mb-6">按分类浏览</h2>
      <div class="grid sm:grid-cols-2 gap-6">
        <div class="card p-6">
          <h3 class="font-bold text-gray-900 mb-3">按乐器</h3>
          <div class="flex flex-wrap gap-2">
            <a href="/recordings?instrument=Piano" class="filter-chip">Piano</a>
            <a href="/recordings?instrument=Harpsichord" class="filter-chip">Harpsichord</a>
            <a href="/recordings?instrument=Violin" class="filter-chip">Violin</a>
          </div>
        </div>
        <div class="card p-6">
          <h3 class="font-bold text-gray-900 mb-3">按年代</h3>
          <div class="flex flex-wrap gap-2">
            <a href="/recordings?yearMin=1930&yearMax=1960" class="filter-chip">1930-1960</a>
            <a href="/recordings?yearMin=1960&yearMax=1990" class="filter-chip">1960-1990</a>
            <a href="/recordings?yearMin=1990&yearMax=2025" class="filter-chip">1990-至今</a>
          </div>
        </div>
      </div>
    </section>

  </div>

  <script>
    const allRecordings = {recordings};
    const searchInput = document.getElementById('home-search') as HTMLInputElement;
    const resultsDiv = document.getElementById('search-results')!;

    searchInput?.addEventListener('input', () => {
      const q = searchInput.value.toLowerCase().trim();
      if (q.length < 1) {
        resultsDiv.classList.add('hidden');
        return;
      }

      const matches = allRecordings.filter((r: any) =>
        r.performer.toLowerCase().includes(q) ||
        r.label.toLowerCase().includes(q) ||
        String(r.year).includes(q) ||
        r.instrument.toLowerCase().includes(q) ||
        (r.notes && r.notes.toLowerCase().includes(q))
      ).slice(0, 8);

      if (matches.length === 0) {
        resultsDiv.innerHTML = '<div class="px-4 py-3 text-gray-400">没有找到匹配的录音</div>';
      } else {
        resultsDiv.innerHTML = matches.map((r: any) => `
          <a href="/recordings/${r.id}" class="flex items-center gap-3 px-4 py-3 hover:bg-gold-50 transition-colors border-b border-gray-100 last:border-0">
            <div class="w-10 h-10 bg-gold-100 rounded overflow-hidden flex-shrink-0 flex items-center justify-center">
              <img src="${r.coverUrl}" alt="" class="w-full h-full object-cover" onerror="this.style.display='none'; this.parentElement.innerHTML='<span>♪</span>'"/>
            </div>
            <div>
              <div class="font-medium text-gray-900">${r.performer}</div>
              <div class="text-sm text-gray-500">${r.year} · ${r.label} · ${r.instrument}</div>
            </div>
          </a>
        `).join('');
      }
      resultsDiv.classList.remove('hidden');
    });

    // Close on click outside
    document.addEventListener('click', (e) => {
      if (!searchInput?.contains(e.target as Node) && !resultsDiv?.contains(e.target as Node)) {
        resultsDiv?.classList.add('hidden');
      }
    });

    // Navigate on Enter
    searchInput?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        const q = searchInput.value.trim();
        if (q) window.location.href = `/recordings?search=${encodeURIComponent(q)}`;
      }
    });
  </script>
</Layout>
